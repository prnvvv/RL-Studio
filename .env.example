# RL Studio environment configuration. Copy to `.env` (gitignored) and fill in values.
# Secrets are read by the backend only; never put them in frontend code or VITE_* variables.
# Runtime AI inference uses hosted Groq / Hugging Face APIs only. There is no local inference.

# --- Provider credentials -----------------------------------------------------
# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=
# Hugging Face access token: https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Groq models (verify each against your account's /models catalogue) -------
# Original Meta Muse Spark replacement: intent interpretation
GROQ_INTENT_MODEL=openai/gpt-oss-20b
# Original Meta Muse Spark replacement: structured requirement extraction
GROQ_REQUIREMENTS_MODEL=openai/gpt-oss-20b
# Original Meta Muse Wonder replacement: root-cause investigation
GROQ_ROOT_CAUSE_MODEL=openai/gpt-oss-120b
# Original Meta Muse Wonder replacement: investigation assistance
GROQ_INVESTIGATION_MODEL=openai/gpt-oss-120b
# Original Meta Muse Voice Transcribe replacement: voice transcription (via the backend)
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# --- Vision (Original Meta Muse Image replacement) ----------------------------
# Set only to a verified vision-capable model supported by the selected provider.
VISION_PROVIDER=huggingface
VISION_MODEL=
# Optional Groq vision model, only if account access and image support are verified.
GROQ_VISION_MODEL=

# --- Hugging Face hosted inference --------------------------------------------
# Hosted Inference Providers or a dedicated Inference Endpoint.
HF_INFERENCE_PROVIDER=
# Optional override of the OpenAI-compatible router (default https://router.huggingface.co/v1)
HF_INFERENCE_BASE_URL=
# Original Meta SAM 3.1 replacement: must be an accessible hosted segmentation model/endpoint.
HF_SEGMENTATION_MODEL=
HF_SEGMENTATION_ENDPOINT=

# --- Runtime ------------------------------------------------------------------
AI_PROVIDER_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_ENABLE_FALLBACK=true
AI_ENABLE_VISUAL_INVESTIGATION=true
AI_ENABLE_SEGMENTATION=true
AI_ENABLE_VOICE_TRANSCRIPTION=true
AI_LOG_PROMPTS=false
AI_LOG_RESPONSES=false
# Upload limits (bytes)
AI_MAX_AUDIO_BYTES=10485760
AI_MAX_IMAGE_BYTES=8388608
