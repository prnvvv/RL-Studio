# RL Studio environment configuration. Copy to `.env` (gitignored) and fill in values.
# Secrets are read by the backend only; never put them in frontend code or VITE_* variables.
# Runtime AI inference uses the Meta Model API only. There is no local inference and no other provider.

# ============================================================
# META MODEL API - GLOBAL CONFIGURATION
# ============================================================
# One shared key serves every Meta-hosted model (Muse Spark, Muse Wonder, Muse Image, Muse Voice Transcribe, SAM 3.1).
# There is no per-model key and no other inference provider. Backend-only: never put it in frontend/VITE_* variables.

META_API_BASE_URL=https://api.meta.ai/v1

# Create this key in the Meta Model API dashboard (https://dev.meta.ai/ -> your team and project -> API Keys).
# Never commit the actual value.
MODEL_API_KEY=

# ============================================================
# META MODEL IDENTIFIERS (each is read by backend/ai/registry.py)
# ============================================================

META_DEFAULT_MODEL=muse-spark-1.3

META_INTENT_MODEL=muse-spark-1.3
META_REQUIREMENTS_MODEL=muse-spark-1.3
META_GENERAL_MODEL=muse-spark-1.3

META_ROOT_CAUSE_MODEL=muse-wonder-1.0
META_INVESTIGATION_MODEL=muse-wonder-1.0
META_RECOVERY_PLANNING_MODEL=muse-wonder-1.0

META_VISION_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
META_VOICE_MODEL=muse-voice-transcribe-1.0
META_SEGMENTATION_MODEL=sam-3.1

# ============================================================
# FEATURE AVAILABILITY
# ============================================================

META_VISION_ENABLED=true
META_IMAGE_GENERATION_ENABLED=true
META_VOICE_ENABLED=true
META_SEGMENTATION_ENABLED=true

# Muse Wonder is a preview model; enable only after access is verified.
META_WONDER_ENABLED=true

# ============================================================
# API RELIABILITY
# ============================================================

META_API_TIMEOUT_SECONDS=90
META_API_MAX_RETRIES=2
META_API_RETRY_BACKOFF_SECONDS=1

# When a Muse Wonder (preview) task cannot be served, fall back to Muse Spark. The fallback is always reported.
AI_ENABLE_FALLBACK=true
AI_LOG_PROMPTS=false
AI_LOG_RESPONSES=false
# Upload limits (bytes). Meta voice accepts WAV only, up to 10 minutes / 32 MB.
AI_MAX_AUDIO_BYTES=10485760
AI_MAX_IMAGE_BYTES=8388608
