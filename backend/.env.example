# ============================================================
# RL Studio - Person 3 Verification Foundation (TEMPLATE)
# Meta Model API - placeholders only, never commit real credentials
# ============================================================

# Meta Model API credential - replace with real key before use.
MODEL_API_KEY=REPLACE_WITH_META_API_KEY

# Base URL documented in the current project instructions.
META_API_BASE_URL=https://api.meta.ai/v1

# Default Meta model documented in the project instructions.
META_DEFAULT_MODEL=muse-spark-1.3

# Optional task-specific model overrides (verified for this account).
META_INTENT_MODEL=
META_DIAGNOSIS_MODEL=
META_ANALYSIS_MODEL=

# HTTP request timeout, in seconds.
META_API_TIMEOUT_SECONDS=30

# Maximum attempts for explicitly retryable transient failures.
META_API_MAX_ATTEMPTS=3

# Initial retry backoff, in seconds.
META_API_RETRY_BASE_SECONDS=1

# ============================================================
# Verification workflow
# ============================================================

VERIFICATION_MAX_WORKFLOW_STEPS=30
VERIFICATION_LLM_ENABLED=true

# ============================================================
# Input and context limits
# ============================================================

VERIFICATION_MAX_EVIDENCE_BYTES=1048576
VERIFICATION_MAX_PROMPT_CHARS=20000

# ============================================================
# Logging
# ============================================================

LOG_LEVEL=INFO