# RL Studio backend configuration TEMPLATE - copy to backend/.env and fill in.
# Hosted APIs only (Groq / Hugging Face). Never commit real keys.

# Shared credentials (fallback for any model without its own key below)
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
GROQ_API_KEYS=
GROQ_KEY_CALL_LIMIT=0
HF_TOKEN=REPLACE_WITH_HF_TOKEN

# Per-model credentials (dedicated key is tried first, then the shared ones)
GROQ_INTENT_API_KEY=REPLACE_WITH_GROQ_INTENT_API_KEY
GROQ_REQUIREMENTS_API_KEY=REPLACE_WITH_GROQ_REQUIREMENTS_API_KEY
GROQ_ROOT_CAUSE_API_KEY=REPLACE_WITH_GROQ_ROOT_CAUSE_API_KEY
GROQ_INVESTIGATION_API_KEY=REPLACE_WITH_GROQ_INVESTIGATION_API_KEY
GROQ_TRANSCRIPTION_API_KEY=REPLACE_WITH_GROQ_TRANSCRIPTION_API_KEY
GROQ_VISION_API_KEY=REPLACE_WITH_GROQ_VISION_API_KEY
HF_VISION_API_KEY=REPLACE_WITH_HF_VISION_API_KEY
HF_SEGMENTATION_API_KEY=REPLACE_WITH_HF_SEGMENTATION_API_KEY

# Models
GROQ_INTENT_MODEL=openai/gpt-oss-20b
GROQ_REQUIREMENTS_MODEL=openai/gpt-oss-20b
GROQ_ROOT_CAUSE_MODEL=openai/gpt-oss-120b
GROQ_INVESTIGATION_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
VISION_PROVIDER=huggingface
VISION_MODEL=
GROQ_VISION_MODEL=
HF_SEGMENTATION_MODEL=
HF_SEGMENTATION_ENDPOINT=

# Runtime
AI_PROVIDER_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_ENABLE_FALLBACK=true
VERIFICATION_MAX_WORKFLOW_STEPS=30
VERIFICATION_LLM_ENABLED=true
VERIFICATION_MAX_EVIDENCE_BYTES=1048576
VERIFICATION_MAX_PROMPT_CHARS=20000
LOG_LEVEL=INFO
