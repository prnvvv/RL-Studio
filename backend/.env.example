# ============================================================
# RL Studio - Person 3 Verification Foundation (TEMPLATE)
# Grok / xAI API - placeholders only, never commit real credentials
# ============================================================

# Grok/xAI API credential - replace with real key before use.
XAI_API_KEY=REPLACE_WITH_XAI_API_KEY
# Legacy (still supported): META_AI_API_KEY, GROK_API_KEY, MODEL_API_KEY

# Base URL for Grok/xAI API.
XAI_BASE_URL=https://api.x.ai/v1

# Default Grok model.
XAI_MODEL=grok-2-latest

# Optional task-specific model overrides.
XAI_INTENT_MODEL=
XAI_DIAGNOSIS_MODEL=
XAI_ANALYSIS_MODEL=

# HTTP request timeout, in seconds.
XAI_API_TIMEOUT_SECONDS=30

# Maximum attempts for explicitly retryable transient failures.
XAI_API_MAX_ATTEMPTS=3

# Initial retry backoff, in seconds.
XAI_API_RETRY_BASE_SECONDS=1

# ============================================================
# Verification workflow
# ============================================================

VERIFICATION_MAX_WORKFLOW_STEPS=30
VERIFICATION_LLM_ENABLED=true

# ============================================================
# Input and context limits
# ============================================================

VERIFICATION_MAX_EVIDENCE_BYTES=1048576
VERIFICATION_MAX_PROMPT_CHARS=20000

# ============================================================
# Logging
# ============================================================

LOG_LEVEL=INFO