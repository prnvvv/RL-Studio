# Self-Healing RL Studio — frontend environment (placeholders only; never commit real values)
# Copy to `.env.local` and adjust locally.

# Clerk publishable key for authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_XXX

# Backend API base URL. Leave empty in development to use the same origin
# (matching the Vite dev proxy setup, if configured).
VITE_API_BASE_URL=http://localhost:8000

# Development mock adapters (labeled "Sample data" in the UI).
# Must be exactly "true" to enable fixtures; anything else keeps them off.
VITE_USE_MOCKS=false
