# ============================================================================
# Self-Healing RL Studio — Comprehensive .gitignore
# ============================================================================
# This file prevents generated, local, and temporary artifacts from being
# committed. It is deliberately comprehensive for the documented project
# architecture while preserving dependency manifests, configuration templates,
# and source code necessary to build and maintain the project.
# ============================================================================

# Python & virtual environments
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (folders)
.venv/
venv/
ENV/
env/
.direnv/

# Python bytecode
.pyc
.pyw

# Django/Flask/WSGI
*.sage

# PyInstaller
*.manifest
*.exe
*.dylib
*.app

# Jupyter notebooks
.ipynb_checkpoints/

# Virtual environment configuration files
.python-version
pyvenv.cfg

# Local configuration & secrets
.env
.local.env

# ============================================================================
# Dependency caches & build artifacts
# ============================================================================

# Build/distribution
.build/
dist/
eggs/
*.egg-info/
develop-eggs/
sdist/
var/
wheels/

# Python package cache
.pip-cache/

# IDE & tooling caches
.cache/
.tox/
.opencode/

# ============================================================================
# Environment variables & secrets
# ============================================================================

# Ignore local .env files but explicitly allow templates
.env
!.env.example
!.env.template

# ============================================================================
# Logs, temporary files & runtime state
# ============================================================================

# Logs
logs/
*.log
*.tok

# Database files
*.db
*.sqlite
*.sqlite3
*.gdb

# Runtime state
*.pid
*.seed

# ============================================================================
# Test artifacts, coverage & caches
# ============================================================================

# Coverage
.coverage
htmlcov/
*.cover

# pytest
.pytest_cache/
tests/.pytest_cache/

# Hypothesis
.hypothesis/

# Code coverage for numpy/pandas
numpy_coverage/

# ============================================================================
# IDE & editor files
# ============================================================================

# Visual Studio Code
.vscode/
*.code-workspace

# JetBrains / IntelliJ
.idea/
*~

# OS-specific
.DS_Store       # macOS
Thumbs.db       # Windows
ehthumbs.db     # Windows
Trash.tn        # Windows

# ============================================================================
# Frontend / JavaScript / TypeScript
# ============================================================================

# Node.js / npm / Yarn
node_modules/
.yarn-integrity/
.yarn/

# Next.js / Create React App / Vite
.next/
out/
out-ts/
.build/

# Package manager lockfiles — preserved (listed separately below)

# TypeScript / JavaScript build outputs
*.profraw
*.prof

# ============================================================================
# Docker
# ============================================================================

# Docker build cache
docker-build-cache/

# Docker compose override
docker-compose.override.yml

# ============================================================================
# Documentation tooling artifacts
# ============================================================================

# Docs build (if using Sphinx/MkDocs)
docs/_build/
docs/_static/
docs/.doctrees

# ============================================================================
# Markdown files (excluding README.md which is the public facing doc)
# ============================================================================
*.md
!README.md

# ============================================================================
# CRITICAL: Files that must NEVER be ignored
# ============================================================================

# Python dependency manifests — always track these
requirements.txt

# Project configuration
pyproject.toml

# JavaScript package manifests
package.json

# JavaScript package lockfiles — always track these
package-lock.json
yarn.lock

# Git ignored patterns that follow
!  # (no-op to ensure above are never overridden)

# ============================================================================
# Environment templates — preserved for onboarding
# ============================================================================

# These templates are safe to commit; they contain placeholder values only
!.env.example
!.env.template

AGENTS.md
opencode.md
**/AGENTS.md
**/ARCHITECTURE.md
**/opencode.md
**/TODO.md

# ============================================================================
# End of .gitignore
# ============================================================================